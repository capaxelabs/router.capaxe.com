meta {
  name: Video Generate
  type: http
  seq: 18
}

post {
  url: {{APP_URL}}/v1/videos/generations
  body: json
  auth: none
}

body:json {
  {
    "model": "google/veo-3-fast",
    "prompt": "Create a cinematic video of a person walking through a futuristic city at sunset",
    "image": {
      "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8/5+hHgAHggJ/PchI7wAAAABJRU5ErkJggg==",
      "type": "image/png",
      "filename": "reference.png"
    },
    "duration": 5,
    "fps": 24,
    "size": "720x720",
    "response_format": "url"
  }
}

tests {
  test("Status should be 200 or contain error details", function() {
    if (res.getStatus() !== 200) {
      expect(res.getBody().error).to.be.an('object');
    }
  });
  
  test("Response should have data array when successful", function() {
    if (res.getStatus() === 200) {
      expect(res.getBody().data).to.be.an('array');
      expect(res.getBody().data[0]).to.have.property('url');
    }
  });
}

docs {
  Generate videos using base64 encoded input images for image-to-video conversion.
  
  This is the optimized method for video generation that accepts base64 image data directly,
  providing better performance for programmatic video generation workflows.
  
  Parameters:
  - model: Google video model ID (e.g., "google/veo-3-fast", "google/veo-3")
  - prompt: Text description of the video to generate or editing instruction
  - image: Base64 image object for image-to-video (optional):
    - data: Base64 encoded image data (without data:image/... prefix)
    - type: MIME type (e.g., "image/png", "image/jpeg")
    - filename: Optional filename for reference
  - duration: Video length in seconds (1-10, default: 5)
  - fps: Frames per second (12-60, default: 24)
  - size: Video dimensions ("1280x720", "1920x1080", or "auto", default: "auto")
  - response_format: Response format ("url" or "b64_json", default: "url")
  
  Video Generation Types:
  - Text-to-Video: Omit the "image" field for pure text-based video generation
  - Image-to-Video: Include "image" field to animate a static image into video
  
  Benefits of Base64 Input:
  - No file upload overhead
  - Direct processing from memory
  - Better performance for automated workflows
  - Consistent with image generation API format
  
  Note: Video generation may take 30-120 seconds. Consider using async=true query parameter
  for longer operations: /v1/openai/videos/generations?async=true
  
  Returns:
  - created: Unix timestamp
  - data: Array with video URL(s) or base64 data
  - cost: Optional generation cost information
}
