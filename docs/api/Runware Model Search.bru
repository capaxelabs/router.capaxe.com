meta {
  name: Runware Model Search
  type: http
  seq: 14
}

post {
  url: {{APP_URL}}/v1/runware/models/search
  body: json
  auth: none
}

body:json {
  {
    "search": "realistic",
    "tags": ["photorealistic"],
    "category": "checkpoint",
    "architecture": "sdxl",
    "type": "base",
    "visibility": "public",
    "offset": 0,
    "limit": 10
  }
}

tests {
  test("Status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Should return data array", function() {
    expect(res.getBody().data).to.be.an('array');
  });
  
  test("Should contain search results", function() {
    const searchData = res.getBody().data[0];
    expect(searchData).to.have.property('taskType');
    expect(searchData).to.have.property('totalResults');
    expect(searchData).to.have.property('results');
    expect(searchData.taskType).to.equal('modelSearch');
  });
  
  test("Results should contain AIR identifiers", function() {
    const results = res.getBody().data[0].results;
    if (results && results.length > 0) {
      expect(results[0]).to.have.property('air');
      expect(results[0]).to.have.property('name');
      expect(results[0]).to.have.property('category');
    }
  });
}

docs {
  Search for models in the Runware catalog with various filters.
  
  ## Request Parameters:
  - search: Search term to find models (searches across names, versions, tags)
  - tags: Array of tags to filter by (e.g., ["photorealistic", "realistic"])
  - category: Model category (checkpoint, lora, controlnet, vae, embeddings, lycoris)
  - type: Model type for checkpoints (base, inpainting, refiner)
  - architecture: Model architecture (sdxl, flux1d, sd3, pony, imagen3, etc.)
  - conditioning: ControlNet conditioning type (canny, depth, pose, etc.)
  - visibility: Filter by visibility (public, private, community, favorite) - default: public
  - offset: Pagination offset (default: 0)
  - limit: Results per page (default: 20, max: 100)
  
  ## Response:
  Returns a data array containing:
  - taskUUID: Unique identifier for the search task
  - taskType: "modelSearch"
  - totalResults: Total number of models matching the criteria
  - results: Array of model objects with:
    - name: Model name
    - air: AIR identifier (use this in generation requests)
    - tags: Array of tags
    - heroImage: Preview image URL
    - category: Model category
    - architecture: Model architecture
    - version: Model version
    - defaultWidth/defaultHeight: Recommended dimensions
    - defaultSteps/defaultCFG: Recommended parameters
  
  ## Using Results:
  Once you find a model, use its 'air' identifier in image generation:
  {
    "model": "civitai:305149@392545",
    "prompt": "your prompt here",
    "size": "1024x1024"
  }
  
  ## Pagination:
  For large result sets, use offset and limit:
  - Page 1: offset=0, limit=20
  - Page 2: offset=20, limit=20
  - Page 3: offset=40, limit=20
}
