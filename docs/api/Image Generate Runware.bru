meta {
  name: Image Generate Runware
  type: http
  seq: 13
}

post {
  url: {{APP_URL}}/v1/openai/images/generations
  body: json
  auth: none
}

body:json {
  {
    "model": "runware/kling-2.1-standard",
    "prompt": "A cute cartoon cat playing with a ball of yarn, colorful, kawaii style",
    "n": 1,
    "size": "512x512",
    "response_format": "url"
  }
}

tests {
  test("Status should be 200 or contain error details", function() {
    if (res.getStatus() !== 200) {
      expect(res.getBody().error).to.be.an('object');
    }
  });
  
  test("Should return base64 data when successful", function() {
    if (res.getStatus() === 200) {
      expect(res.getBody().data[0].b64_json).to.be.a('string');
    }
  });
}

docs {
  Generate images with base64-encoded response instead of URLs.
  
  When response_format is set to "b64_json", the API returns:
  - Images as base64-encoded strings in the data[].b64_json field
  - No URLs are generated or stored
  - Useful for immediate processing or when you don't need permanent storage
  
  Note: Base64 responses can be large and may impact request/response times.
}
