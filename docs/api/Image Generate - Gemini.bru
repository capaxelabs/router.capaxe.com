meta {
  name: Image Generate - Gemini
  type: http
  seq: 10
}

post {
  url: {{APP_URL}}/v1/images/generations
  body: json
  auth: none
}

body:json {
  {
    "model": "google/gemini-2.5-flash",
    "prompt": "Create a 1/7 scale commercialized figurine of the character in the picture, in a realistic style, in a real environment. The figurine is placed on a computer desk. The figurine has a round transparent acrylic base. The content on the computer screen is a 3D modeling process of this figurine. Next to the computer screen is a toy packaging box, designed in a style reminiscent of high-quality collectible figures, printed with original artwork. The packaging features two-dimensional flat illustrations of the figurine.",
    "n": 1,
    "size": "1024x1024",
    "quality": "high",
    "response_format": "url"
  }
  
  
}

tests {
  test("Status should be 200 or contain error details", function() {
    if (res.getStatus() !== 200) {
      expect(res.getBody().error).to.be.an('object');
    }
  });
}

docs {
  Generate images using Google Gemini models.
  
  NOTE: Async processing is now the DEFAULT behavior. The request will return a task ID
  for tracking generation status. Add ?sync=true query parameter for synchronous processing.
  
  Parameters:
  - model: Google model ID (e.g., "google/gemini-2.0-flash-exp")
  - prompt: Text description of the image to generate
  - n: Number of images to generate (1-16, default: 1)
  - size: Image dimensions ("1024x1024" or "auto", default: "auto")
  - quality: Image quality ("auto", "low", "medium", "high")
  - response_format: Response format ("url" or "b64_json", default: "url")
  - user: Optional user identifier
  
  Query Parameters:
  - sync: Set to "true" for synchronous processing (default: async)
  
  Returns (Async - Default):
  - taskId: Task identifier for status checking
  - status: "pending" 
  - type: "image"
  - createdAt: Unix timestamp
  - message: Instructions for checking status
  
  Returns (Sync - with ?sync=true):
  - created: Unix timestamp
  - data: Array of generated images with URLs or base64 data
  - cost: Optional generation cost
}
