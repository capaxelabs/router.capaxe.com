meta {
  name: Admin - Get Model
  type: http
  seq: 34
}

get {
  url: {{BASE_URL}}/admin/models/google/gemini-2.5-flash
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ADMIN_API_KEY}}
}

tests {
  test("Should return model details", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().model).to.be.an('object');
    expect(res.getBody().model.id).to.equal("google/gemini-2.5-flash");
  });
  
  test("Should return 404 for non-existent model", function() {
    if (res.getStatus() === 404) {
      expect(res.getBody().success).to.be.false;
      expect(res.getBody().error).to.include("not found");
    }
  });
}

docs {
  # Get Single Model
  
  Retrieves detailed information about a specific model by its ID.
  
  ## URL Parameter
  - **:id**: The model ID (e.g., "google/gemini-2.5-flash")
  
  ## Response Format
  ```json
  {
    "success": true,
    "model": {
      "id": "google/gemini-2.5-flash",
      "name": "Gemini 2.5 Flash",
      "slug": "gemini-25-flash",
      "type": "image",
      "status": "active",
      "isPublic": true,
      "providers": [
        {
          "id": "gemini",
          "model_name": "gemini-2.5-flash-image-preview",
          "pricing": {
            "type": "post_generation",
            "value": 0.0272
          }
        }
      ],
      "arenaScore": 1167,
      "releaseDate": "2025-08-26",
      "description": "Fast image generation model",
      "examples": [...],
      "capabilities": {
        "supportsImage": true,
        "aspectRatios": ["1:1", "3:4", "4:3", "16:9", "9:16"]
      },
      "applyImageFn": "gemini25FlashApplyImage",
      "postCalcPriceFn": "gemini25FlashPostCalc",
      "tags": ["fast", "multi-modal", "google"],
      "category": "text-to-image",
      "createdAt": 1234567890,
      "updatedAt": 1234567890
    }
  }
  ```
  
  ## Authentication
  Requires ADMIN_API_KEY in Authorization header.
  
  ## Response Codes
  - **200**: Model found and returned
  - **401**: Missing or invalid admin key
  - **404**: Model not found
  - **500**: Server error
  
  ## Notes
  - Results are cached for 5 minutes
  - Functions from registry are included if available
  - All JSON fields are automatically parsed
  - Useful for verifying model configuration before updates
}
