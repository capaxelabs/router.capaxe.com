meta {
  name: Chat - Completions (Streaming)
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{api_key}}
}

body:json {
  {
    "model": "gemini-2.0-flash",
    "messages": [
      {"role": "user", "content": "Count from 1 to 10"}
    ],
    "stream": true
  }
}

docs {
  # Chat Completions (Streaming)

  Streaming chat completions using Server-Sent Events (SSE).

  ## Request

  Set `stream: true` in the request body.

  ## Response Format

  Returns SSE stream with chunks:
  ```
  data: {"id":"chatcmpl-123","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":"1"}}]}
  data: {"id":"chatcmpl-123","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":","}}]}
  data: {"id":"chatcmpl-123","object":"chat.completion.chunk","choices":[{"index":0,"delta":{},"finish_reason":"stop"}]}
  data: [DONE]
  ```

  ## Usage with curl

  ```bash
  curl -N -X POST {{BASE_URL}}/v1/chat/completions \
    -H "Authorization: Bearer YOUR_API_KEY" \
    -H "Content-Type: application/json" \
    -d '{"model":"gemini-2.0-flash","messages":[{"role":"user","content":"Hello"}],"stream":true}'
  ```
}
