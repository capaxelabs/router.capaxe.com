meta {
  name: Video Generation - Multiple Images
  type: http
  seq: 16
}

post {
  url: {{APP_URL}}/v1/openai/videos/generations
  body: json
  auth: none
}

body:json {
  {
    "model": "google/veo-3-fast",
    "prompt": "Create a smooth transition video morphing between these different scenes",
    "image": [
      {
        "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8/5+hHgAHggJ/PchI7wAAAABJRU5ErkJggg==",
        "type": "image/png",
        "filename": "scene1.png"
      },
      {
        "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYGAAAAACAAFRoJRuAAAAAElFTkSuQmCC",
        "type": "image/png",
        "filename": "scene2.png"
      }
    ],
    "duration": 8,
    "fps": 30,
    "size": "1920x1080",
    "response_format": "url"
  }
}

tests {
  test("Should return task ID for async processing", function() {
    if (res.getStatus() === 200) {
      expect(res.getBody()).to.have.property('taskId');
      expect(res.getBody()).to.have.property('status', 'pending');
      expect(res.getBody()).to.have.property('type', 'video');
    }
  });
  
  test("Status should be 200 or contain error details", function() {
    if (res.getStatus() !== 200) {
      expect(res.getBody().error).to.be.an('object');
    }
  });
}

docs {
  Advanced video generation using multiple base64 input images.
  
  This endpoint demonstrates complex video generation scenarios where multiple reference
  images are used to create sophisticated video content with transitions, morphing, or
  scene composition.
  
  Parameters:
  - model: Google video model that supports multiple images
  - prompt: Detailed description of how to use the multiple images
  - image: Array of base64 image objects:
    - data: Base64 encoded image data for each frame/reference
    - type: MIME type
    - filename: Optional reference name
  - duration: Video length (longer for complex multi-image videos)
  - fps: Frame rate (higher for smoother transitions)
  - size: Video resolution
  - async: Recommended for multi-image processing
  
  Use Cases:
  - Image morphing and transitions
  - Scene composition from multiple references
  - Style transfer across different images  
  - Creating narratives from image sequences
  - Complex visual storytelling
  
  Processing Notes:
  - Multi-image videos typically take longer to generate
  - Use async=true to avoid timeout issues
  - The model interprets images based on the prompt instructions
  - Order of images in array may affect the result
  
  Example Prompts:
  - "Create a smooth transition morphing between these scenes"
  - "Use the first image as the starting point and the second as the ending"
  - "Blend these images into a cohesive video narrative"
  - "Apply the style from the first image to animate the second"
}
