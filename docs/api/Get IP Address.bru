meta {
  name: Get IP Address
  type: http
  seq: 4
}

get {
  url: {{BASE_URL}}/ip
  body: none
  auth: none
}

tests {
  test("Status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response should contain IP", function() {
    expect(res.getBody().ip).to.be.a('string');
  });
}

docs {
  Debug endpoint to check the detected client IP address.
  Useful for testing rate limiting and proxy configurations.
  
  Returns:
  - ip: Detected client IP address
}
