{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imagerouter-hono",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "imagerouter-storage",
      "preview_bucket_name": "imagerouter-storage-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imagerouter-db",
      "database_id": "",
      "preview_database_id": ""
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}