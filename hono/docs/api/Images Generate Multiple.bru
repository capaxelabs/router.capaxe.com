meta {
  name: Images Generate Multiple
  type: http
  seq: 9
}

post {
  url: {{APP_URL}}/v1/openai/images/generations
  body: json
  auth: none
}

body:json {
  {
    "model": "google/gemini-2.5-flash",
    "prompt": "Create variations of this image with different lighting conditions",
    "image": [
      {
        "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8/5+hHgAHggJ/PchI7wAAAABJRU5ErkJggg==",
        "type": "image/png",
        "filename": "source1.png"
      },
      {
        "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYGAAAAACAAFRoJRuAAAAAElFTkSuQmCC",
        "type": "image/png", 
        "filename": "source2.png"
      }
    ],
    "n": 4,
    "size": "1024x1024",
    "quality": "medium",
    "response_format": "url"
  }
}

tests {
  test("Status should be 200 or contain error details", function() {
    if (res.getStatus() !== 200) {
      expect(res.getBody().error).to.be.an('object');
    }
  });
  
  test("Should return multiple images when successful", function() {
    if (res.getStatus() === 200) {
      expect(res.getBody().data).to.be.an('array');
      expect(res.getBody().data.length).to.equal(4);
    }
  });
}

docs {
  Generate multiple image variations using multiple base64 input images.
  
  This endpoint demonstrates advanced usage where you can provide multiple source images
  and generate multiple variations, all using base64 encoded data for optimal performance.
  
  Parameters:
  - model: Google model ID
  - prompt: Description of variations to create
  - image: Array of base64 image objects:
    - data: Base64 encoded image data
    - type: MIME type
    - filename: Optional reference name
  - n: Total number of images to generate (1-16)
  - size: Output dimensions
  - quality: Generation quality
  - response_format: Output format
  
  Behavior:
  - Multiple input images provide context/references
  - The model uses all images to understand the desired style
  - Generates 'n' total images, not per input image
  - Useful for style transfer and consistent variations
  
  Performance Benefits:
  - No file I/O overhead
  - Direct processing from memory
  - Faster batch operations
  - Reduced server load
  
  Example Use Cases:
  - Style consistency across image sets
  - Batch processing with reference images
  - A/B testing different source materials
  - Multi-image composition tasks
}
