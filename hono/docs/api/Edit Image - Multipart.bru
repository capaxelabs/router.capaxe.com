meta {
  name: Edit Image - Multipart
  type: http
  seq: 9
}

post {
  url: {{APP_URL}}/v1/openai/images/edits
  body: multipartForm
  auth: none
}

body:multipart-form {
  model: google/gemini-2.0-flash-exp
  prompt: Transform this image into a painting in the style of Van Gogh
  n: 1
  size: 1024x1024
  response_format: url
  image: @file(/path/to/your/image.jpg)
}

docs {
  Edit or transform existing images using multipart form upload.
  
  Required:
  - image: Image file to edit (JPEG, PNG, WebP, GIF up to 20MB)
  - prompt: Description of how to edit the image
  - model: Google model to use for editing
  
  Optional:
  - mask: Mask image file for selective editing (up to 10MB)
  - n: Number of variations to generate
  - size: Output image size
  - quality: Output quality
  - response_format: "url" or "b64_json"
  
  Note: Replace @file(/path/to/your/image.jpg) with actual file path in Bruno.
}

tests {
  test("Status should be 200 or contain error details", function() {
    if (res.getStatus() !== 200) {
      expect(res.getBody().error).to.be.an('object');
    }
  });
}