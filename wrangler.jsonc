{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imagerouter",
  "account_id": "81cac75fe318d80f4344481afc4799ac",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-24",
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imagerouter",
      "database_id": "2d9212ff-9135-4ea0-9d2d-76de2a78f641"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "R2_BUCKET_NAME": "imagerouter",
    "R2_CUSTOM_PUBLIC_URL": "https://storage.shootflo.com"
  },
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "imagerouter",
      "preview_bucket_name": "imagerouter-preview"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ASYNC_QUEUE",
        "queue": "imagerouter-async-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "imagerouter-async-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "imagerouter-failed-tasks"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}