# ImageRouter Environment Variables (Development)
# Copy this file to .dev.vars and fill in your values

# All AI inference runs through the Cloudflare AI binding (env.AI) + AI Gateway.
# No provider API keys are needed - third-party models use Unified Billing.
# Optional: name of the AI Gateway to route through (defaults to 'default')
CF_AI_GATEWAY_ID=default

# Database: Cloudflare D1 via the DB binding in wrangler.jsonc - no credentials needed.
# `wrangler dev` uses a local D1 copy; add --remote to hit the real database.

# Storage (R2) - S3 API credentials required for uploads
R2_BUCKET_NAME=imagerouter
R2_CUSTOM_PUBLIC_URL=https://storage.example.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Authentication
JWT_SECRET=your-jwt-secret-min-32-chars

# Admin API
ADMIN_API_KEY=your-secure-admin-key-min-32-chars

# Environment
ENVIRONMENT=development
PROXY_COUNT=0
